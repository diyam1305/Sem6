<!--(5)	WAP for mouse handling  event, when user click on the div then text colour will change black to white
and div background colour change to blue-->
<!DOCTYPE html>
<html>
<body>

<div id="box" style="width:100px; height:100px; background:red; color:black;">
    Click Me
</div>

<script>
document.getElementById("box").onclick = function() {
    this.style.background = "blue";
    this.style.color = "white";
}
</script>
</body>
</html>
